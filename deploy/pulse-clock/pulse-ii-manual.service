[Unit]
Description=Forward a manual Pulse II edition request
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=pulse-ii-manual
StateDirectoryMode=0700
LoadCredential=github-app-key:/etc/pulse-ii-clock/github-app-key.pem
LoadCredential=github-app:/etc/pulse-ii-clock/github-app.json
LoadCredential=edition-desk:/etc/pulse-ii-clock/edition-desk.json
ExecStart=/usr/bin/python3 /usr/local/lib/pulse-ii-clock/manual.py
TimeoutStartSec=90s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
