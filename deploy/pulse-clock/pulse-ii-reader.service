[Unit]
Description=Owner browser access to Pulse II
After=network-online.target
[Service]
DynamicUser=yes
StateDirectory=pulse-ii-reader
StateDirectoryMode=0700
LoadCredential=edition-desk:/etc/pulse-ii-clock/edition-desk.json
ExecStart=/usr/bin/python3 /usr/local/lib/pulse-ii-clock/reader.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
